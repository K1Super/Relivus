# Relivus 本地开发环境变量模板（PostgreSQL 默认；MySQL 见文末注释切换）
# 用法：复制为根目录 .env（已被 .gitignore 忽略，不会提交），填写真实值后
#       执行 scripts/start-dev.ps1（Windows）或 scripts/start-dev.sh（Linux/macOS）启动。
# 密钥生成：
#   RELIVUS_AES_KEY / RELIVUS_HMAC_KEY: openssl rand -base64 32 （Base64 后 32 字节）
#   RELIVUS_TOKEN: 任意固定字符串即可（如 openssl rand -hex 16）

# ---- 元数据库（Relivus 自有库，启动时自动 Flyway 迁移建表）----
# PostgreSQL
RELIVUS_META_URL=jdbc:postgresql://127.0.0.1:5432/relivus_meta
RELIVUS_META_USER=relivus
RELIVUS_META_PASSWORD=<元数据库密码>

# 注释上面的 PostgreSQL 三项、取消下面三行注释即切换为 MySQL：
# RELIVUS_META_URL=jdbc:mysql://127.0.0.1:3306/relivus_meta
# RELIVUS_META_USER=relivus
# RELIVUS_META_PASSWORD=<元数据库密码>

# ---- 安全密钥 ----
RELIVUS_AES_KEY=<Base64的32字节密钥>
RELIVUS_HMAC_KEY=<Base64的32字节密钥>

# ---- API 访问 Token（前端设置页登录 / 直连 API 使用）----
RELIVUS_TOKEN=<固定Token>

# ---- 可选（有默认值，不需要可不填）----
# RELIVUS_KEY_VERSION=1
# RELIVUS_TASK_CORE=4
# RELIVUS_TASK_MAX=8
# RELIVUS_TASK_QUEUE=100
# RELIVUS_SSE_MAX=20
# RELIVUS_TARGET_POOLS=20