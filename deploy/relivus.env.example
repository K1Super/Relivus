# Relivus 生产环境变量清单
# 拷贝为 /etc/relivus/relivus.env（chmod 600，属主 relivus）后填写真实值，禁止提交明文密钥到仓库。
# 密钥生成：
#   RELIVUS_AES_KEY / RELIVUS_HMAC_KEY: openssl rand -base64 32 （AES-256-GCM / HMAC 各需 32 字节）
#   RELIVUS_TOKEN: openssl rand -hex 16 （任意固定字符串即可）
# 元数据库地址示例（PostgreSQL）：
#   RELIVUS_META_URL=jdbc:postgresql://127.0.0.1:5432/relivus_meta
# 元数据库地址示例（MySQL）：
#   RELIVUS_META_URL=jdbc:mysql://127.0.0.1:3306/relivus_meta

RELIVUS_META_URL=jdbc:postgresql://127.0.0.1:5432/relivus_meta
RELIVUS_META_USER=relivus
RELIVUS_META_PASSWORD=<强密码>
RELIVUS_AES_KEY=<Base64的32字节密钥>
RELIVUS_HMAC_KEY=<Base64的32字节密钥>
RELIVUS_TOKEN=<固定Token>

# 以下可选，带默认值：
# RELIVUS_KEY_VERSION=1
# RELIVUS_TASK_CORE=4
# RELIVUS_TASK_MAX=8
# RELIVUS_TASK_QUEUE=100
# RELIVUS_SSE_MAX=20
# RELIVUS_TARGET_POOLS=20
# RELIVUS_SWAGGER_ENABLED=false