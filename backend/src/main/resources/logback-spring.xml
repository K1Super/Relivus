<?xml version="1.0" encoding="UTF-8"?>
<!--
  Relivus 日志配置（日志治理规范）：
  - 禁止 System.out / printStackTrace 直出；
  - 关键节点与异常场景输出结构化内容，TraceId 经 MDC 透传（%X{traceId}）；
  - prod profile 输出单行 | 分隔字段（ts|level|traceId|logger|msg），便于采集与解析；
  - 任务执行属异步线程，TaskDecorator 已透传 MDC。
-->
<configuration>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="relivus"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [traceId=%X{traceId:-}] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 生产：单行结构化（| 分隔，无 ANSI 转义，便于 systemd/journald 采集） -->
    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}|%level|%X{traceId:-}|%logger{36}|%msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.relivus" level="DEBUG"/>
    </springProfile>

    <!-- 敏感信息防泄漏：SQL 参数摘要日志级别收紧，避免密钥/密码进入日志 -->
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="com.mysql.cj.jdbc" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>

</configuration>